<logic>
  atur title = "Docs - letswhim"
</logic>

<template>
  <whim:navbar />

  <div class="max-w-4xl mx-auto px-6 md:px-10 py-20 pb-40">
    <h1 class="text-huge tracking-tightest font-bold leading-none mb-10 text-[var(--text)]">docs<span class="opacity-20">.</span></h1>

    <section class="mb-20">
      <div class="flex items-center gap-4 mb-6">
        <span class="text-4xl font-bold opacity-10 text-[var(--text)]">00</span>
        <h2 class="text-3xl font-bold tracking-tight text-[var(--text)]">Installation</h2>
      </div>
      <p class="opacity-60 mb-6 leading-relaxed text-[var(--text)]">
        Ensure <strong class="text-[var(--text)] underline">Node.js v22</strong> is installed. Run the command below.
      </p>
      
      <div class="bg-[var(--text)]/5 p-8 rounded-3xl font-mono text-sm border border-[var(--text)]/10 mb-6">
        <span class="opacity-50"># Create new project</span><br>
        <span class="text-[var(--text)]">npm create letswhim@latest my-app</span><br><br>
        <span class="opacity-50"># Start server</span><br>
        <span class="text-[var(--text)]">cd my-app && lw dev</span>
      </div>
    </section>

    <section class="glass p-10 rounded-3xl border mb-10" style="border-color: var(--border)">
  <h2 class="text-2xl font-bold mb-4 flex items-center gap-3 text-[var(--text)]">
    <i data-lucide="cpu" class="w-5 h-5"></i> Core Logic
  </h2>
  <div class="grid gap-4">
    <div class="p-4 bg-[var(--text)]/5 rounded-xl border border-[var(--text)]/10">
       <code class="font-bold text-[var(--text)]">atur x = "value"</code>
       <p class="text-xs opacity-50 mt-1">Alias untuk const/let (Variable declaration).</p>
    </div>
    
    <div class="p-4 bg-[var(--text)]/5 rounded-xl border border-[var(--text)]/10">
       <code class="font-bold text-[var(--text)]">tunggu ...</code>
       <p class="text-xs opacity-50 mt-1">Alias untuk await (Handle asynchronous operations).</p>
    </div>

    <div class="p-4 bg-[var(--text)]/5 rounded-xl border border-[var(--text)]/10">
       <code class="font-bold text-[var(--text)]">ambil(url)</code>
       <p class="text-xs opacity-50 mt-1">Alias sakti untuk fetch() yang otomatis jadi JSON.</p>
    </div>
  </div>
</section>
  </div>
</template>