<logic>
  atur title = "Examples - letswhim"
  atur crypto = tunggu ambil("https://api.coincap.io/v2/assets/bitcoin")
</logic>

<template>
  <whim:navbar />

  <div class="flex h-[calc(100vh-80px)] overflow-hidden">
    
    <aside class="w-64 border-r p-8 overflow-y-auto hidden md:block bg-[var(--bg)]" style="border-color: var(--border)">
      <h3 class="text-xs font-bold opacity-40 uppercase tracking-widest mb-6 text-[var(--text)]">Patterns</h3>
      <ul class="space-y-4 text-sm font-medium opacity-70">
        <li><a href="#routing" class="hover:opacity-100 transition block text-[var(--text)]">1. File Routing</a></li>
        <li><a href="#components" class="hover:opacity-100 transition block text-[var(--text)]">2. Components</a></li>
        <li><a href="#fetching" class="hover:opacity-100 transition block text-[var(--text)]">3. Data Fetching</a></li>
      </ul>
    </aside>

    <div class="flex-1 overflow-y-auto p-10 md:p-20 scroll-smooth">
      <div class="max-w-3xl">
        <h1 class="text-6xl font-extrabold tracking-tightest mb-4 text-[var(--text)]">examples<span class="opacity-20">.</span></h1>
        <p class="text-xl opacity-50 mb-16 text-[var(--text)]">Production-ready code patterns.</p>

        <section id="routing" class="mb-24 pt-10">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-3xl font-bold opacity-20 text-[var(--text)]">01</span>
            <h2 class="text-3xl font-bold tracking-tight text-[var(--text)]">File-System Routing</h2>
          </div>
          <p class="opacity-60 mb-6 text-[var(--text)]">
            Create a <code class="bg-[var(--text)]/10 px-2 rounded">.letswhim</code> file to automatically generate a route.
          </p>
          <div class="glass p-6 rounded-2xl">
            <pre class="font-mono text-sm text-[var(--text)] opacity-80">/project
  ├── index.letswhim   → /
  └── about.letswhim   → /about</pre>
          </div>
        </section>

        <section id="components" class="mb-24 pt-10">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-3xl font-bold opacity-20 text-[var(--text)]">02</span>
            <h2 class="text-3xl font-bold tracking-tight text-[var(--text)]">Modular Components</h2>
          </div>
          <p class="opacity-60 mb-6 text-[var(--text)]">
            Encapsulate UI logic into reusable files. Call them using the <code class="bg-[var(--text)]/10 px-2 rounded">whim:tag</code> syntax.
          </p>
          <div class="glass p-6 rounded-2xl">
            <pre class="font-mono text-sm text-[var(--text)] opacity-80">&lt;!-- components/card.letswhim --&gt;
&lt;whim:card title="Hello World" /&gt;</pre>
          </div>
        </section>

        <section id="fetching" class="mb-24 pt-10">
          <div class="flex items-center gap-4 mb-6">
            <span class="text-3xl font-bold opacity-20 text-[var(--text)]">03</span>
            <h2 class="text-3xl font-bold tracking-tight text-[var(--text)]">Async Data</h2>
          </div>
          
          <div class="p-8 rounded-3xl border border-[var(--text)]/20 relative overflow-hidden">
            <div class="absolute inset-0 bg-[var(--text)]/5"></div>
            <div class="relative z-10">
               <h4 class="font-bold flex items-center gap-2 text-[var(--text)] mb-2"><i data-lucide="activity" class="w-4 h-4"></i> Bitcoin Live</h4>
               <div class="text-5xl font-bold tracking-tighter text-[var(--text)]">
                 ${{ crypto.data.priceUsd ? parseFloat(crypto.data.priceUsd).toFixed(2) : 'Loading...' }}
               </div>
            </div>
          </div>
        </section>
        
        <div class="h-20"></div>
      </div>
    </div>
  </div>
</template>