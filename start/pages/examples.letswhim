<logic>
  atur title = "Examples - letswhim";
  perintah "run" -> "Compiling... <span class='text-emerald-500 font-bold'>Success (15ms)</span>";
  
  // --- NAVIGASI ---
  perintah "home" -> "<a href='/' class='font-bold text-emerald-500 hover:underline'>Return to Root</a>";
  perintah "back" -> "<a href='/' class='font-bold text-emerald-500 hover:underline'>Return to Root</a>";
  
  perintah "help" -> "<div class='text-sm text-gray-500'>Available: <span class='text-gray-900 dark:text-white font-medium'>run, home, back, clear</span></div>";
</logic>

<template>
  <div class="mb-8 border-b border-gray-200 dark:border-gray-800 pb-4 flex justify-between items-center">
    <div class="flex items-center gap-2 text-gray-400 text-sm">
        <a href="/" class="hover:text-gray-900 dark:hover:text-white transition">root</a>
        <span>/</span>
        <span class="text-gray-900 dark:text-white font-medium">examples</span>
    </div>
    <a href="/" class="text-xs px-2 py-1 rounded border border-gray-200 dark:border-gray-700 hover:bg-gray-100 dark:hover:bg-white/5 transition">esc</a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <div class="bg-gray-50 dark:bg-black/40 p-5 rounded-xl border border-gray-200 dark:border-white/5 font-mono text-xs overflow-x-auto shadow-sm">
        <div class="flex gap-1.5 mb-4 border-b border-gray-200 dark:border-white/5 pb-3">
            <div class="w-2.5 h-2.5 rounded-full bg-red-400/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-yellow-400/50"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-green-400/50"></div>
            <span class="ml-2 text-gray-400">demo.letswhim</span>
        </div>
        
        <div class="text-gray-600 dark:text-gray-400 leading-relaxed">
            <span class="text-purple-500">&lt;logic&gt;</span><br>
            &nbsp;&nbsp;<span class="text-blue-600 dark:text-blue-400">atur</span> app = <span class="text-green-600 dark:text-green-400">"LetsWhim"</span>;<br>
            &nbsp;&nbsp;<span class="text-blue-600 dark:text-blue-400">perintah</span> "run" -> <span class="text-green-600 dark:text-green-400">"Compiling..."</span>;<br>
            <span class="text-purple-500">&lt;/logic&gt;</span>
        </div>
    </div>

    <div class="flex flex-col justify-center">
        <h3 class="font-bold mb-2 text-gray-900 dark:text-white">Simplicity in Action</h3>
        <p class="text-sm text-gray-500 mb-6 leading-relaxed">
            Complex build processes are abstracted away. What remains is pure logic and clean markup.
        </p>
        
        <div class="bg-emerald-50 dark:bg-emerald-900/10 p-4 rounded-lg border border-emerald-100 dark:border-emerald-500/20 text-sm">
            <p class="text-xs text-gray-400 mb-1">Interactive Test:</p>
            <span class="text-gray-500">Type:</span> <span class="font-mono text-gray-900 dark:text-white font-bold">run</span><br>
        </div>
    </div>
  </div>
</template>