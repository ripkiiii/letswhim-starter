<logic>
  atur title = "Welcome to LetsWhim";
  atur desc = "Start building high-performance web experiences with L-Lang syntax.";
</logic>

<template>
  <Navbar />
  <main class="starter-main">
    <div class="hero-layout">
      <div class="hero-content">
        <div class="badge-mini">ENGINE V2.0.1 STABLE</div>
        <h1>Hello, <br/><span class="text-accent">LetsWhim</span> <br/>Developer.</h1>
      </div>
      
      <div class="hero-info">
        <p>Your project is ready. Start building high-performance web experiences with L-Lang syntax.</p>
        <div class="step-box">
          <h3>Next Step:</h3>
          <p>Open and edit <code>start/pages/index.lw</code> to customize this page.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />

  <style>
    .starter-main { 
      background: var(--bg); color: var(--text); min-height: 100vh;
      display: flex; align-items: center; justify-content: center; padding: 0 24px;
    }
    .hero-layout { 
      display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; 
      max-width: 1000px; width: 100%; align-items: center;
    }
    .badge-mini { 
      color: var(--accent); font-size: 11px; font-weight: 900; 
      letter-spacing: 1px; margin-bottom: 16px; 
    }
    h1 { font-size: 84px; font-weight: 900; line-height: 0.95; margin: 0; letter-spacing: -4px; }
    .text-accent { color: var(--accent); }
    .hero-info { max-width: 400px; }
    .hero-info p { font-size: 18px; opacity: 0.6; line-height: 1.6; margin-bottom: 32px; }
    .step-box { 
      background: var(--surface); border: 1px solid var(--border); 
      padding: 30px; border-radius: 20px; 
    }
    .step-box h3 { margin: 0 0 12px; font-size: 18px; }
    .step-box p { font-size: 14px; margin: 0; opacity: 0.8; }
    code { color: var(--accent); background: rgba(55, 147, 255, 0.1); padding: 2px 6px; border-radius: 4px; }

    @media (max-width: 968px) {
      .hero-layout { grid-template-columns: 1fr; text-align: center; padding-top: 100px; }
      h1 { font-size: 64px; }
      .hero-info { margin: 0 auto; }
    }
  </style>
</template>